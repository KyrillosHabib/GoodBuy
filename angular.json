{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "website": {
      "projectType": "application",
      "root": "projects/website",
      "sourceRoot": "projects/website/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/website",
            "index": "projects/website/src/index.html",
            "browser": "projects/website/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/website/tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "projects/shared/src/assets", "output": "assets" }
            ],
            "styles": [
              "projects/shared/src/styles/base.css",
              "projects/website/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "port": 4200, "prebundle": false },
          "configurations": {
            "production": { "buildTarget": "website:build:production" },
            "development": { "buildTarget": "website:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "admin": {
      "projectType": "application",
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/admin",
            "index": "projects/admin/src/index.html",
            "browser": "projects/admin/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/admin/tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "projects/shared/src/assets", "output": "assets" }
            ],
            "styles": [
              "projects/shared/src/styles/base.css",
              "projects/admin/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "port": 4201, "prebundle": false },
          "configurations": {
            "production": { "buildTarget": "admin:build:production" },
            "development": { "buildTarget": "admin:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
